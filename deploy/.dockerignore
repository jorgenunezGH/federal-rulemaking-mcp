# deploy/.dockerignore — reference copy of the root .dockerignore.
#
# The file that Docker actually reads is /.dockerignore at the repo root.
# This copy is provided so the deploy/ directory is self-contained for review.
# Keep it in sync with the root .dockerignore.

# Secrets — never bake into image
.env
.env.local

# Git history
.git/
.gitignore

# Virtual environments — pip install handles deps at build time
.venv/
.venv_new/

# Tests and dev tooling
tests/
docs/
evaluations/
.pytest_cache/
.ruff_cache/

# One-off scripts not needed at runtime
api_probe.py
demo.py
demo_output.txt
find_open_comment_docs.py
inspect_sdk_transports.py
measure_latency.py
probe_stub_pywin32.py
run_server_http.py
smoke_test.py
run_mcp_server.py
test_mcp_stdio.py
verify_*.py

# Python bytecode
__pycache__/
*.pyc
*.pyo
